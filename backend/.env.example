APP_NAME="Voice AI Problem Intake Agent"
APP_VERSION=0.1.0
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DEBUG=true
DATABASE_URL=sqlite:///./data/sessions.db
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_VOICE=shubh_enhi_ads
API_AUTH_ENABLED=true
SESSION_TOKEN_TTL_HOURS=24
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_SESSION_CREATION_PER_HOUR=20
MAX_AUDIO_UPLOAD_BYTES=10000000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
OTEL_SERVICE_NAME=paytm-ai-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
# For PostgreSQL, replace DATABASE_URL with:
# postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
